<Project>
  <!--
    Repo-wide compiler strictness (aligned with e-St/fstarter Directory.Build.props).
    Applies to every project under this tree (analyzer, collector, tests, fixtures, samples
    that do not override these properties).

    Intent: local Debug builds, CI, and pack all use the same hard fail-on-warning rules.
  -->
  <PropertyGroup>
    <!-- FS0025 = incomplete pattern match → hard error in every configuration. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>

    <!-- Modern .NET defaults -->
    <Nullable>enable</Nullable>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>

    <!-- Fail the build on any warning (Debug, Release, and CI). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Small allow-list: FS0049 (uppercase identifiers), FS0020 (this value is unused). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);FS0049;FS0020</WarningsNotAsErrors>

    <!-- Deterministic CI-friendly defaults when ContinuousIntegrationBuild is set by agents. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
