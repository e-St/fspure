<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fspure.DocsGenerator</RootNamespace>
    <AssemblyName>fspure-docs</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Tool is independent of Analyzers.SDK FSharp.Core pin. -->
    <DisableImplicitFSharpCoreReference>false</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Snippets.fs" />
    <Compile Include="Human.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>
</Project>
