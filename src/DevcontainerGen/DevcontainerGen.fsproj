<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fspure-devcontainer-gen</AssemblyName>
    <RootNamespace>Fspure.DevcontainerGen</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- JsonNode APIs are heavily nullable; keep this generator simple. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);FS3261;FS3264;FS3262</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
