<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CustomerFixture</RootNamespace>
    <!-- Avoid treating analyzer hints as noise during fixture build -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
