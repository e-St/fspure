<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fspure.Phase3.EmbedLib</PackageId>
    <Version>1.0.0</Version>
    <AssemblyName>EmbedLib</AssemblyName>
    <Nullable>enable</Nullable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Exercise Phase 3 targets without consuming a packed nupkg. -->
    <FspureEmbedPureJson>true</FspureEmbedPureJson>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

  <!-- Import Phase 3 props/targets from the repo (same files shipped in the nupkg). -->
  <Import Project="..\..\..\..\FSharp.PureAnalyzer\build\FSharp.PureAnalyzer.props" />
  <PropertyGroup>
    <!-- In-repo published tools (5 levels up to monorepo root; 4 levels to src/). -->
    <_FspureCollectorDll>$(MSBuildThisFileDirectory)..\..\..\..\..\artifacts\fspure-collector-publish\fspure-collector.dll</_FspureCollectorDll>
    <_FspureEmbedDll>$(MSBuildThisFileDirectory)..\..\..\..\..\artifacts\fspure-embed-publish\fspure-embed.dll</_FspureEmbedDll>
  </PropertyGroup>
  <Import Project="..\..\..\..\FSharp.PureAnalyzer\build\FSharp.PureAnalyzer.targets" />
</Project>
