:root {
  color-scheme: light;
  --sky-top: #f0d9b5;
  --sky-mid: #f6e6c8;
  --sand: #f3e2c4;
  --dune: #e8c99a;
  --dune-deep: #d4a574;
  --desert-blue: #5b8fa8;
  --desert-blue-deep: #3f6f88;
  --text: #4a3428;
  --muted: #7a5c45;
  --link: #2f6b4f;
  --link-hover: #1f4d38;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: var(--text);
  line-height: 1.55;
  background:
    radial-gradient(ellipse 120% 60% at 50% 100%, var(--dune) 0%, transparent 55%),
    linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 38%, var(--sand) 70%, var(--dune) 100%);
}

body::before {
  content: "";
  position: fixed;
  inset: auto 0 0;
  height: 28vh;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 100% at 20% 120%, var(--dune-deep) 0%, transparent 60%),
    radial-gradient(ellipse 90% 100% at 75% 130%, #c9956a 0%, transparent 55%),
    radial-gradient(ellipse 100% 80% at 50% 140%, #b87d52 0%, transparent 50%);
  opacity: 0.45;
  z-index: 0;
}

a {
  color: var(--link);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color 0.15s ease, border-color 0.15s ease;
}

a:hover,
a:focus-visible {
  color: var(--link-hover);
  border-bottom-color: currentColor;
  outline: none;
}

/* Home */
.home {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.75rem;
  padding: 2rem 1.25rem 4rem;
  text-align: center;
}

.home main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.75rem;
}

.logo {
  width: min(420px, 88vw);
  height: auto;
  display: block;
  filter: drop-shadow(0 10px 24px rgba(74, 52, 40, 0.18));
}

.tagline {
  max-width: 28rem;
  font-size: 1.05rem;
  color: var(--muted);
}

.tagline em {
  font-style: normal;
  color: var(--text);
  font-weight: 600;
}

.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.35rem;
  justify-content: center;
  font-size: 0.95rem;
  font-weight: 500;
}

.starter-banner {
  display: inline-block;
  max-width: min(28rem, 100%);
  margin: 0;
  padding: 0.4rem 0.85rem;
  border-radius: 0.4rem;
  border: 1px solid var(--desert-blue);
  background: transparent;
  color: var(--muted);
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.55;
  text-align: center;
}

.starter-banner a {
  color: var(--desert-blue);
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid transparent;
}

.starter-banner a:hover,
.starter-banner a:focus-visible {
  color: var(--desert-blue-deep);
  border-bottom-color: currentColor;
}

.home footer,
.legal-footer {
  position: relative;
  z-index: 1;
  margin-top: 0.25rem;
  font-size: 0.8rem;
  color: var(--muted);
  opacity: 0.9;
}

.home footer nav,
.legal-footer nav {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  justify-content: center;
  margin-top: 0.5rem;
}

/* Legal / get-started article pages */
.legal {
  position: relative;
  z-index: 1;
  max-width: 40rem;
  margin: 0 auto;
  padding: 2.5rem 1.25rem 4rem;
}

.legal header {
  margin-bottom: 1.75rem;
}

.legal h1 {
  font-size: 1.65rem;
  font-weight: 650;
  letter-spacing: -0.02em;
  margin-bottom: 0.35rem;
}

.legal .lead {
  color: var(--muted);
  font-size: 0.95rem;
}

.legal h2 {
  font-size: 1.05rem;
  font-weight: 650;
  margin: 1.5rem 0 0.5rem;
}

.legal p,
.legal li {
  color: var(--text);
  font-size: 0.95rem;
}

.legal p + p {
  margin-top: 0.65rem;
}

.legal ol,
.legal ul {
  margin: 0.5rem 0 0 1.2rem;
}

.legal li {
  margin: 0.25rem 0;
}

.legal address {
  font-style: normal;
  margin-top: 0.5rem;
}

.legal .note {
  margin: 0 0 1.25rem;
  padding: 0.85rem 1rem;
  border-radius: 0.5rem;
  background: rgba(255, 248, 235, 0.65);
  border: 1px solid rgba(184, 125, 82, 0.25);
  color: var(--muted);
  font-size: 0.88rem;
}

.legal .back {
  display: inline-block;
  margin-bottom: 1.25rem;
  font-size: 0.9rem;
  font-weight: 500;
}

.legal code {
  font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
  font-size: 0.88em;
}

.legal p code,
.legal li code {
  padding: 0.12em 0.4em;
  border-radius: 0.3rem;
  background: rgba(74, 52, 40, 0.09);
  border: 1px solid rgba(74, 52, 40, 0.1);
  color: var(--text);
  white-space: nowrap;
}

/* ---------- Code / terminal boxes ---------- */
:root {
  --code-bg: #2a211c;
  --code-bg-2: #342820;
  --code-fg: #f6e9d8;
  --code-muted: #c4a88a;
  --code-accent: #7eb8a0;
  --code-border: rgba(74, 52, 40, 0.35);
  --code-shadow: 0 10px 28px rgba(74, 52, 40, 0.18), 0 2px 6px rgba(74, 52, 40, 0.1);
  --code-label-bg: rgba(126, 184, 160, 0.16);
  --code-label-fg: #9fd4bc;
}

/* Labeled box: preferred for site pages */
.codebox {
  position: relative;
  margin: 1rem 0 1.35rem;
  border-radius: 0.7rem;
  border: 1px solid var(--code-border);
  background:
    linear-gradient(165deg, var(--code-bg-2) 0%, var(--code-bg) 55%, #231b17 100%);
  box-shadow: var(--code-shadow);
  overflow: hidden;
}

.codebox figcaption,
.codebox .codebox-label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  padding: 0.55rem 0.9rem 0.45rem;
  font-family: ui-sans-serif, system-ui, sans-serif;
  font-size: 0.72rem;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--code-label-fg);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent);
  border-bottom: 1px solid rgba(246, 233, 216, 0.08);
}

.codebox figcaption::before,
.codebox .codebox-label::before {
  content: "";
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--code-accent);
  box-shadow:
    0 0 0 2px rgba(126, 184, 160, 0.2),
    1.1rem 0 0 #e2a66a,
    2.2rem 0 0 #c47b6a;
  margin-right: 2.4rem;
  flex-shrink: 0;
}

.codebox[data-lang="shell"] figcaption,
.codebox[data-lang="bash"] figcaption,
.codebox[data-lang="shell"] .codebox-label,
.codebox[data-lang="bash"] .codebox-label {
  color: #9fd4bc;
}

.codebox[data-lang="json"] figcaption,
.codebox[data-lang="json"] .codebox-label {
  color: #e2c07a;
}

.codebox[data-lang="fsharp"] figcaption,
.codebox[data-lang="fsharp"] .codebox-label,
.codebox[data-lang="xml"] figcaption,
.codebox[data-lang="xml"] .codebox-label {
  color: #9bb8e8;
}

.codebox pre,
.legal pre {
  margin: 0;
  padding: 0.95rem 1.1rem 1.1rem;
  overflow-x: auto;
  background: transparent;
  border: none;
  border-radius: 0;
  font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
  font-size: 0.86rem;
  line-height: 1.55;
  color: var(--code-fg);
  tab-size: 2;
  -webkit-overflow-scrolling: touch;
}

/* Bare pre (no figure) still looks like a box */
.legal > pre,
.legal p + pre,
.legal h2 + pre {
  margin: 1rem 0 1.35rem;
  padding: 1rem 1.1rem;
  border-radius: 0.7rem;
  border: 1px solid var(--code-border);
  background:
    linear-gradient(165deg, var(--code-bg-2) 0%, var(--code-bg) 55%, #231b17 100%);
  box-shadow: var(--code-shadow);
  color: var(--code-fg);
}

.codebox pre code,
.legal pre code {
  display: block;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  color: inherit;
  font: inherit;
  white-space: pre;
  word-break: normal;
}

/* Soft syntax accents inside code boxes (no highlighter required) */
.codebox[data-lang="shell"] code::first-line,
.codebox[data-lang="bash"] code::first-line {
  /* visual cue: commands read as one block */
}

.placeholder {
  background: rgba(184, 125, 82, 0.18);
  border-radius: 0.2em;
  padding: 0 0.2em;
}

@media (max-width: 520px) {
  .codebox pre,
  .legal pre {
    font-size: 0.8rem;
    padding-left: 0.85rem;
    padding-right: 0.85rem;
  }

  .codebox figcaption::before,
  .codebox .codebox-label::before {
    margin-right: 2rem;
  }
}
