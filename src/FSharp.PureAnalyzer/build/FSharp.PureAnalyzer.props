<Project>
  <!--
    Fspure / FSharp.PureAnalyzer MSBuild props (Phase 3).
    Auto-imported when the package is referenced.
    Opt out of pure.json generation/embedding with:
      <FspureEmbedPureJson>false</FspureEmbedPureJson>
  -->
  <PropertyGroup>
    <!-- Enable by default: one PackageReference makes a net10.0 library fspure-ready. -->
    <FspureEmbedPureJson Condition="'$(FspureEmbedPureJson)' == ''">true</FspureEmbedPureJson>

    <!-- Optional author escape hatch next to the project file. -->
    <FspurePureExtraJson Condition="'$(FspurePureExtraJson)' == ''">$(MSBuildProjectDirectory)\pure-extra.json</FspurePureExtraJson>

    <!--
      Consumer overrides (scenario 3): place fspure.overrides.json next to the app .fsproj.
      Optional: set env FSPURE_DISABLE_FOUNDATIONAL=1 or FSPURE_OVERRIDES_PATH.
      See src/docs/templates/ARCHITECTURE.md.scriban (generated on the site) for precedence.
    -->
    <FspureOverridesJson Condition="'$(FspureOverridesJson)' == ''">$(MSBuildProjectDirectory)\fspure.overrides.json</FspureOverridesJson>

    <!--
      Resource name defaults are applied in FSharp.PureAnalyzer.targets at CoreBuild time
      so $(AssemblyName) is fully evaluated (avoid embedding as ".pure.json").
      Override with FspurePureJsonResourceName if needed.
    -->

    <!-- Fail the build if collector/embed fails (default true). -->
    <FspureEmbedPureJsonTreatAsError Condition="'$(FspureEmbedPureJsonTreatAsError)' == ''">true</FspureEmbedPureJsonTreatAsError>
  </PropertyGroup>
</Project>
