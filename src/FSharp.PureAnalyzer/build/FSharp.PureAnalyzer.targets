<Project>
  <!--
    Fspure Phase 3: after CoreBuild, run fspure-collector on $(TargetPath),
    optionally merge pure-extra.json, then embed via F# tool (dotnet exec).

    Package layout:
      build/FSharp.PureAnalyzer.props|.targets
      tools/fspure-collector/…
      tools/fspure-embed/…          (F#; replaces former C# MSBuild task DLL)
  -->

  <PropertyGroup>
    <_FspureBuildDir>$(MSBuildThisFileDirectory)</_FspureBuildDir>
    <_FspureCollectorDll Condition="'$(_FspureCollectorDll)' == ''">$(_FspureBuildDir)..\tools\fspure-collector\fspure-collector.dll</_FspureCollectorDll>
    <_FspureEmbedDll Condition="'$(_FspureEmbedDll)' == ''">$(_FspureBuildDir)..\tools\fspure-embed\fspure-embed.dll</_FspureEmbedDll>
  </PropertyGroup>

  <Target Name="FspureGenerateAndEmbedPureJson"
          AfterTargets="CoreBuild"
          Condition="'$(FspureEmbedPureJson)' == 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' != 'false'
                     and Exists('$(TargetPath)')">

    <PropertyGroup>
      <FspureGeneratedPureJson Condition="'$(FspureGeneratedPureJson)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(AssemblyName).pure.json</FspureGeneratedPureJson>
      <FspurePureJsonResourceName Condition="'$(FspurePureJsonResourceName)' == ''">$(AssemblyName).pure.json</FspurePureJsonResourceName>
      <_FspurePureJsonOut>$([System.IO.Path]::GetFullPath('$(FspureGeneratedPureJson)'))</_FspurePureJsonOut>
      <_FspureTargetPath>$([System.IO.Path]::GetFullPath('$(TargetPath)'))</_FspureTargetPath>
      <_FspureCollectorDllFull>$([System.IO.Path]::GetFullPath('$(_FspureCollectorDll)'))</_FspureCollectorDllFull>
      <_FspureEmbedDllFull>$([System.IO.Path]::GetFullPath('$(_FspureEmbedDll)'))</_FspureEmbedDllFull>
      <_FspurePackageVersion Condition="'$(Version)' != ''">$(Version)</_FspurePackageVersion>
      <_FspurePackageVersion Condition="'$(_FspurePackageVersion)' == ''">0.0.0</_FspurePackageVersion>
      <_FspureMergeArgs></_FspureMergeArgs>
      <_FspureSkipEmbed>false</_FspureSkipEmbed>
    </PropertyGroup>

    <PropertyGroup Condition="Exists('$(FspurePureExtraJson)')">
      <_FspureMergeArgs>--merge-with "$([System.IO.Path]::GetFullPath('$(FspurePureExtraJson)'))"</_FspureMergeArgs>
    </PropertyGroup>

    <Warning Condition="!Exists('$(_FspureCollectorDllFull)')"
             Text="Fspure: fspure-collector not found at '$(_FspureCollectorDllFull)'; skipping pure.json embed." />
    <PropertyGroup Condition="!Exists('$(_FspureCollectorDllFull)')">
      <_FspureSkipEmbed>true</_FspureSkipEmbed>
    </PropertyGroup>

    <Error Condition="'$(_FspureSkipEmbed)' == 'true' and '$(FspureEmbedPureJsonTreatAsError)' == 'true' and !Exists('$(_FspureCollectorDllFull)')"
           Text="Fspure: fspure-collector not found at '$(_FspureCollectorDllFull)'." />

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_FspurePureJsonOut)'))"
             Condition="'$(_FspureSkipEmbed)' != 'true'" />

    <PropertyGroup>
      <_FspureCollectorContinueOnError>false</_FspureCollectorContinueOnError>
      <_FspureCollectorContinueOnError Condition="'$(FspureEmbedPureJsonTreatAsError)' != 'true'">true</_FspureCollectorContinueOnError>
    </PropertyGroup>

    <Exec Condition="'$(_FspureSkipEmbed)' != 'true'"
          Command="dotnet exec &quot;$(_FspureCollectorDllFull)&quot; --defaults false --assembly &quot;$(_FspureTargetPath)&quot; -o &quot;$(_FspurePureJsonOut)&quot; --package-id &quot;$(AssemblyName)&quot; --package-version &quot;$(_FspurePackageVersion)&quot; --public-only true $(_FspureMergeArgs)"
          LogStandardErrorAsError="true"
          ConsoleToMSBuild="true"
          ContinueOnError="$(_FspureCollectorContinueOnError)">
      <Output TaskParameter="ExitCode" PropertyName="_FspureCollectorExitCode" />
    </Exec>

    <Error Condition="'$(_FspureSkipEmbed)' != 'true' and '$(FspureEmbedPureJsonTreatAsError)' == 'true' and '$(_FspureCollectorExitCode)' != '0' and '$(_FspureCollectorExitCode)' != ''"
           Text="Fspure: fspure-collector failed with exit code $(_FspureCollectorExitCode)." />

    <Error Condition="'$(_FspureSkipEmbed)' != 'true' and '$(FspureEmbedPureJsonTreatAsError)' == 'true' and !Exists('$(_FspurePureJsonOut)')"
           Text="Fspure: expected pure.json at '$(_FspurePureJsonOut)' after collector run." />

    <Error Condition="'$(_FspureSkipEmbed)' != 'true' and Exists('$(_FspurePureJsonOut)') and !Exists('$(_FspureEmbedDllFull)') and '$(FspureEmbedPureJsonTreatAsError)' == 'true'"
           Text="Fspure: fspure-embed tool missing at '$(_FspureEmbedDllFull)'." />

    <Exec Condition="'$(_FspureSkipEmbed)' != 'true' and Exists('$(_FspurePureJsonOut)') and Exists('$(_FspureEmbedDllFull)')"
          Command="dotnet exec &quot;$(_FspureEmbedDllFull)&quot; --assembly &quot;$(_FspureTargetPath)&quot; --pure-json &quot;$(_FspurePureJsonOut)&quot; --resource-name &quot;$(FspurePureJsonResourceName)&quot;"
          LogStandardErrorAsError="true"
          ConsoleToMSBuild="true"
          ContinueOnError="false" />

    <Message Importance="normal"
             Condition="'$(_FspureSkipEmbed)' != 'true' and Exists('$(_FspurePureJsonOut)')"
             Text="Fspure: embedded $(FspurePureJsonResourceName) into $(_FspureTargetPath)" />
  </Target>
</Project>
