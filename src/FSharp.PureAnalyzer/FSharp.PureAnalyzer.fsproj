<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Packaging (nuget.org + GitHub Packages) -->
    <IsPackable>true</IsPackable>
    <PackageId>FSharp.PureAnalyzer</PackageId>
    <Version>0.4.0</Version>
    <Description>F# analyzer that classifies definitions as pure or impure (PURE002 / PURE003) for Ionide and fsharp-analyzers. Includes MSBuild targets to embed pure.json into net10.0 library DLLs.</Description>
    <PackageTags>fsharp;analyzer;pure;functional;ionide;fsautocomplete;msbuild</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/e-St/fspure</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/e-St/fspure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>e-St</Authors>
    <Copyright>Copyright (c) e-St and contributors</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Analyzer packaging -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Paths used when packing collector + embed tools -->
    <_FspureCollectorPublish>$(MSBuildThisFileDirectory)..\..\artifacts\fspure-collector-publish\</_FspureCollectorPublish>
    <_FspureEmbedPublish>$(MSBuildThisFileDirectory)..\..\artifacts\fspure-embed-publish\</_FspureEmbedPublish>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PureSet.fs" />
    <Compile Include="ReferencedAssemblies.fs" />
    <Compile Include="PureManifestLoader.fs" />
    <Compile Include="Name.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Analyzer.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="foundational.pure.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared PureFile schema + PE pure.json reader (net10.0). -->
    <ProjectReference Include="..\FSharp.PureSchema\FSharp.PureSchema.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\docs\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Place the analyzer DLL (and PureSchema dependency) where Ionide expects them -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/fs"
          Visible="false" />
    <None Include="$(OutputPath)FSharp.PureSchema.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/fs"
          Visible="false" />
  </ItemGroup>

  <!-- Phase 3: MSBuild props/targets (auto-imported on PackageReference) -->
  <ItemGroup>
    <None Include="build\FSharp.PureAnalyzer.props" Pack="true" PackagePath="build\" />
    <None Include="build\FSharp.PureAnalyzer.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!--
    Stage F# tools (collector + embed) into the nupkg before GenerateNuspec.
  -->
  <Target Name="PrepareFspurePackageTools" BeforeTargets="GenerateNuspec;_GetPackageFiles;Pack">
    <Message Importance="high" Text="Fspure: publishing fspure-collector + fspure-embed for package layout..." />

    <MakeDir Directories="$(_FspureCollectorPublish);$(_FspureEmbedPublish)" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\fspure-collector\fspure-collector.fsproj&quot; -c $(Configuration) -f net10.0 -o &quot;$(_FspureCollectorPublish)&quot; --nologo -v q" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Fspure.Embed\Fspure.Embed.fsproj&quot; -c $(Configuration) -f net10.0 -o &quot;$(_FspureEmbedPublish)&quot; --nologo -v q" />

    <ItemGroup>
      <_FspureCollectorFiles Include="$(_FspureCollectorPublish)**\*.*" />
      <None Include="@(_FspureCollectorFiles)"
            Pack="true"
            PackagePath="tools\fspure-collector\%(RecursiveDir)%(Filename)%(Extension)"
            Visible="false" />
      <_FspureEmbedFiles Include="$(_FspureEmbedPublish)**\*.*" />
      <None Include="@(_FspureEmbedFiles)"
            Pack="true"
            PackagePath="tools\fspure-embed\%(RecursiveDir)%(Filename)%(Extension)"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>
