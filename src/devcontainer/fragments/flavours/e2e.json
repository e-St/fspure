{
  "name": "fspure e2e (code-server + Playwright)",
  "image": "ghcr.io/e-st/fstarter:latest",
  "remoteEnv": {
    "CODE_SERVER_PORT": "8080",
    "CODE_SERVER_HOST": "127.0.0.1"
  },
  "postCreateCommand": "bash src/tests/e2e/phase2/.devcontainer/post-create.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "code-server",
      "onAutoForward": "notify"
    }
  }
}
