{
  "flavours": {
    "ide": {
      "description": "Default Codespaces / Reopen in Container (interactive IDE)",
      "fragments": ["base.json", "vscode-common.json", "flavours/ide.json"],
      "output": ".generated/devcontainer/ide/devcontainer.json",
      "platform": ".devcontainer/devcontainer.json"
    },
    "build": {
      "description": "CI pack/build (paket/dotnet/bundlef) — no IDE lifecycle",
      "fragments": ["base.json", "flavours/build.json"],
      "output": ".generated/devcontainer/build/devcontainer.json",
      "platform": "src/FSharp.PureAnalyzer/.devcontainer/devcontainer.json"
    },
    "e2e": {
      "description": "Customer e2e (code-server + Playwright)",
      "fragments": ["base.json", "vscode-common.json", "flavours/e2e.json"],
      "output": ".generated/devcontainer/e2e/devcontainer.json",
      "platform": "src/tests/e2e/phase2/.devcontainer/devcontainer.json"
    }
  }
}
