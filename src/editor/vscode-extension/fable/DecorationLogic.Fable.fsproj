<?xml version="1.0" encoding="utf-8"?>
<!-- Fable project: compiles shared Logic.fs → ../src/logic.js (CommonJS for VS Code). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER</DefineConstants>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);FS3261;FS3264;NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Fspure.DecorationLogic\Logic.fs" Link="Logic.fs" />
    <Compile Include="Exports.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.5.0" />
  </ItemGroup>
</Project>
