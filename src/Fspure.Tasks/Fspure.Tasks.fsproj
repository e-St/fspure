<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fspure.Tasks</RootNamespace>
    <AssemblyName>fspure</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <DisableImplicitFSharpCoreReference>false</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Repo.fs" />
    <Compile Include="Security.fs" />
    <Compile Include="ReadyLibGate.fs" />
    <Compile Include="Phase5.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
