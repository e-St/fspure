# Source of truth for fspure versions applied into e-St/fstarter.
# Updated by release / PR-to-fstarter workflow (or edit by hand).
# setup-fspure.sh sources this file when present next to itself or as fspure-versions.env.
FSPURE_ANALYZER_VERSION=0.4.0
# gh skill defaults to the latest GitHub Release tag (v0.4.0), which predates the
# skill. Pin main until the next official analyzer tag; apply-version-pins then
# sets this to v{analyzer} so install and the release tag stay aligned.
FSPURE_SKILL_REF=main
