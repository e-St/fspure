<Project>
  <PropertyGroup>
    <!-- === Compiler Strictness (source of truth shared with e-St/fspure Directory.Build.props) ===
         FS0025 = incomplete pattern match. Treating this as an error turns F#'s
         exhaustive matching into a hard compile-time guarantee. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>

    <Nullable>enable</Nullable>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>

    <!-- Fail on any warning in Debug and Release (same as fspure monorepo). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);FS0049;FS0020</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
