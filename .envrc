# direnv + nix-direnv: enter the flake devShell without starting a raw bash session.
# Install: https://direnv.net/  +  nix profile install nixpkgs#nix-direnv
#
#   cd <repo>   # auto-loads flake inputs / packages
#   direnv allow
#
# Prefer Nushell for interactive work once loaded:
#   nu
#   use src/scripts/fspure.nu *
#   fspure docs preview

if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RuwIS+QKFj/T9M2TFXScjBsLR6V3A17YVoEW/Q6AZ1w="
fi

use flake

# Optional: quieter reloads
# export FSPURE_QUIET=1
