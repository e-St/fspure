{
  "name": "fspure e2e (code-server + Playwright)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "code-server (VS Code Web)",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "CODE_SERVER_PORT": "8080",
    "CODE_SERVER_HOST": "127.0.0.1"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "tests/e2e/customer-fixture/customer-fixture.slnx",
        "FSharp.workspaceModePeekDeepLevel": 1,
        "FSharp.showExplorerOnStartup": true,
        "FSharp.pipelineHints.enabled": true,
        "FSharp.pipelineHints.prefix": "// ",
        "fsharpPureDecorations.impureColor": "#E2A66A",
        "fsharpPureDecorations.pureColor": "#6A9955"
      }
    }
  }
}
