{
  "name": "F# .NET (Paket + Fun.Build + Ionide)",
  "image": "ghcr.io/e-st/fstarter:latest",
  "remoteUser": "vscode",
  // Latest FSharp.PureAnalyzer (nuget.org) + fsharp-pure-decorations (Open VSX VSIX).
  "postCreateCommand": "bash .devcontainer/setup-fspure-ide.sh",
  // `code` CLI is available after attach; re-run is cheap if already installed.
  "postAttachCommand": "bash .devcontainer/setup-fspure-ide.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ionide.ionide-fsharp",
        "ionide.ionide-paket",
        "ionide.ionide-fantomas",
        "ms-dotnettools.csharp"
      ],
      "settings": {
        // === Reduce intrusive autocompletions while typing ===
        "editor.inlineSuggest.enabled": false,
        "editor.parameterHints.enabled": false,
        "editor.acceptSuggestionOnEnter": "off",
        "[fsharp]": {
          "editor.quickSuggestions": false,
          "editor.suggestOnTriggerCharacters": false
        },
        // === Inlay Hints: HM-style types shown AFTER the code (on demand) ===
        "dotnet.defaultSolution": "fspure.slnx",
        "FSharp.workspacePath": "fspure.slnx",
        "FSharp.enableMSBuildProjectGraph": true,
        "editor.inlayHints.enabled": "on",
        "FSharp.inlayHints.typeAnnotations": false,
        "FSharp.inlayHints.parameterNames": true,
        "FSharp.inlayHints.enabled": true, // kept for compatibility (the above editor. setting is preferred)
        "FSharp.lineLens.enabled": "replaceCodeLens",
        "FSharp.lineLens.prefix": "// ",
        "FSharp.linter": true,
        "FSharp.enableAnalyzers": true,
        "FSharp.analyzersPath": [
          "analyzers",
          "packages/Analyzers",
          "${userHome}/.nuget/packages/fsharp.pureanalyzer"
        ],
        "FSharp.unusedDeclarationsAnalyzer": true, // Best for detecting unused code
        "FSharp.codeLenses.references.enabled": false, // Optional: shows "X references" above lines
        "editor.formatOnSave": true,
        "fsharpPureDecorations.enabled": true,
        "workbench.colorCustomizations": {
          "editorHint.foreground": "#00000000",
          "editorHint.border": "#00000000",
          "editorOverviewRuler.hintForeground": "#00000000"
        },
        "files.exclude": {
          "**/obj": true,
          "**/bin": true,
          "**/.paket": true
        }
      }
    }
  },
  "features": {},
  "remoteEnv": {
    "DOTNET_ROLL_FORWARD": "Major",
    // Keep NuGet scratch off /tmp (chmod 700 can fail on some Docker/CI mounts).
    "TMPDIR": "/home/vscode/.cache/nuget-tmp",
    "TEMP": "/home/vscode/.cache/nuget-tmp",
    "TMP": "/home/vscode/.cache/nuget-tmp"
  }
}
