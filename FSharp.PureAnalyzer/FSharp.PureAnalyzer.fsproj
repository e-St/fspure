<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Packaging (nuget.org + GitHub Packages) -->
    <IsPackable>true</IsPackable>
    <PackageId>FSharp.PureAnalyzer</PackageId>
    <Version>0.1.0</Version>
    <Description>F# analyzer that classifies definitions as pure or impure (PURE002 / PURE003) for Ionide and fsharp-analyzers.</Description>
    <PackageTags>fsharp;analyzer;pure;functional;ionide;fsautocomplete</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/e-St/fspure</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/e-St/fspure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>e-St</Authors>
    <Copyright>Copyright (c) e-St and contributors</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Analyzer packaging -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PureSet.fs" />
    <Compile Include="Name.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Analyzer.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="foundational.pure.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Place the analyzer DLL where Ionide expects it -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/fs"
          Visible="false" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>