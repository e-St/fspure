<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FSharp.PureAnalyzer.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Match FSharp.Analyzers.SDK / FCS pin used by the analyser. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CompositionTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.PureAnalyzer\FSharp.PureAnalyzer.fsproj" />
    <ProjectReference Include="..\schema\FSharp.PureSchema\FSharp.PureSchema.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.0.101" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
