{
  "name": "fspure phase2 visual e2e",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "code-server (VS Code Web)",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "DOTNET_ROLL_FORWARD": "Major",
    "CODE_SERVER_PORT": "8080",
    "CODE_SERVER_HOST": "127.0.0.1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ionide.ionide-fsharp",
        "ms-dotnettools.csharp"
      ]
    }
  }
}
