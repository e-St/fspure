<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FSharp.PureAnalyzer.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Match FSharp.Analyzers.SDK / FCS pin used by the analyser. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestProcess.fs" />
    <Compile Include="CompositionTests.fs" />
    <Compile Include="OverrideTests.fs" />
    <Compile Include="PathResolutionTests.fs" />
    <Compile Include="ManifestIntegrationTests.fs" />
    <Compile Include="MsBuildEmbeddingTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharp.PureAnalyzer\FSharp.PureAnalyzer.fsproj" />
    <ProjectReference Include="..\..\src\FSharp.PureSchema\FSharp.PureSchema.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact pin required by FSharp.Compiler.Service 43.10.101 / Analyzers.SDK 0.35. -->
    <PackageReference Include="FSharp.Core" Version="10.0.101" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
